// ============================================================================
// BeautyBot — Schema do banco de dados
// PostgreSQL 16 + Prisma
//
// Documentação completa da modelagem: docs/DATABASE.md
//
// Convenções:
//   · Entidades de catálogo  → id cuid,   updatedAt, soft delete (deletedAt)
//   · Tabelas de evento      → id BigInt, append-only, sem updatedAt
//   · Dinheiro               → Decimal(12,2) + coluna currency
//   · Taxas / percentuais    → Decimal(5,4) ou Decimal(5,2)
//   · Datas                  → Timestamptz(3), sempre em UTC
//   · Nomes físicos          → snake_case via @map / @@map
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a connection string vive em prisma.config.ts, não aqui.
datasource db {
  provider = "postgresql"
}

// ============================================================================
